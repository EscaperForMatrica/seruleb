{
  // Worker без кода — раздаётся только статика.
  // Исходники страниц лежат в корне как *.dc.html, сборщик build.js
  // складывает готовый сайт в dist/ (эта папка не хранится в репозитории).
  "name": "seruleb",
  "compatibility_date": "2026-07-24",

  // Сборка перед деплоем. Дублирует поле Build command в панели Cloudflare —
  // если панель по какой-то причине не выполнит команду, wrangler сделает это сам.
  "build": {
    "command": "node build.js"
  },

  // Основной адрес *.workers.dev остаётся включённым.
  // Задано явно, чтобы убрать предупреждение из лога сборки.
  "workers_dev": true,

  // Отдельные публичные адреса для каждой версии деплоя выключены,
  // чтобы у сайта был ровно один адрес.
  "preview_urls": false,

  "assets": {
    "directory": "./dist"
  }
}
