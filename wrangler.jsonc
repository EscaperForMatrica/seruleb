{
  // Worker без кода — только статические файлы.
  // Cloudflare раздаёт содержимое каталога как есть, шага сборки нет.
  "name": "seruleb",
  "compatibility_date": "2026-07-24",

  // Основной адрес *.workers.dev остаётся включённым.
  // Задано явно — это и так поведение по умолчанию, просто убирает
  // предупреждение из лога сборки.
  "workers_dev": true,

  // Отдельные публичные адреса для каждой версии деплоя выключены,
  // чтобы у сайта был ровно один адрес.
  "preview_urls": false,

  "assets": {
    "directory": "./"
  }
}
